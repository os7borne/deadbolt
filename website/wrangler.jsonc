// Static information page for deadbolt.osborne.vc. Deployed 2026-11-18 (Worker deadbolt-site).
// Redeploy: cd website && npx wrangler@4 deploy
{
  "name": "deadbolt-site",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public" },
  // lab-login.osborne.vc: the "login on another subdomain" host for /lab test 5 (same site: osborne.vc)
  "routes": [
    { "pattern": "deadbolt.osborne.vc", "custom_domain": true },
    { "pattern": "lab-login.osborne.vc", "custom_domain": true }
  ]
}
